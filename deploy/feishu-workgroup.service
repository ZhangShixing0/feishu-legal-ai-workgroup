[Unit]
Description=Feishu Legal Multi-Agent Workgroup
After=network-online.target lawsuit.service material-extractor.service
Wants=network-online.target

[Service]
Type=simple
User=lawsuit
Group=lawsuit
WorkingDirectory=/opt/lawsuit-app
Environment=PYTHONUNBUFFERED=1
Environment=FEISHU_WORKGROUP_DATA_DIR=/opt/lawsuit-app/outputs/feishu-workgroup
EnvironmentFile=/opt/lawsuit-app/.env.feishu
ExecStart=/usr/bin/python3 -m feishu_workgroup.run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lawsuit-app/outputs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
