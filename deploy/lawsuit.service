[Unit]
Description=Law Firm Legal Document Generator
After=network.target

[Service]
Type=simple
User=lawsuit
Group=lawsuit
WorkingDirectory=/opt/lawsuit-app
Environment=PYTHONUNBUFFERED=1
Environment=LEGAL_DEPLOYMENT_MODE=server
Environment=LEGAL_JOB_RETENTION_HOURS=24
ExecStart=/usr/bin/python3 /opt/lawsuit-app/server.py --host 127.0.0.1 --port 8765 --no-browser
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lawsuit-app/outputs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
