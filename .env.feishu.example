# 复制为 .env.feishu 后填写；不要把真实 Secret 提交到版本库。
FEISHU_MATERIAL_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_MATERIAL_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DRAFT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_DRAFT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 正式部署后的 HTTPS 地址，用于第二步补充信息页面。
FEISHU_WORKGROUP_PUBLIC_URL=https://legal.example.com/ai-workgroup
# 仅在同一台电脑本地体验时改为 1；服务器部署保持 0。
FEISHU_WORKGROUP_LOCAL_MODE=0
FEISHU_WORKGROUP_HOST=127.0.0.1
FEISHU_WORKGROUP_PORT=8788
FEISHU_WORKGROUP_DATA_DIR=feishu_workgroup/data

# 现有两套服务的内部地址和材料核对页外部地址。
FEISHU_EXTRACTOR_API_URL=http://127.0.0.1:8777
FEISHU_EXTRACTOR_REVIEW_URL=https://legal.example.com/extractor
FEISHU_GENERATOR_API_URL=http://127.0.0.1:8765

# 提取任务轮询间隔和最长等待时间（秒）。
FEISHU_JOB_POLL_SECONDS=2
FEISHU_JOB_MAX_WAIT_SECONDS=1800

# 正式使用建议填写允许接入的飞书群 chat_id，多个用英文逗号分隔。
FEISHU_ALLOWED_CHAT_IDS=
